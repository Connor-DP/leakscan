# Scan input and output are sensitive by definition — never commit either.
input/
output/
*.zip
# ...except the synthetic corpus, which is fabricated test data and belongs in
# the repo. It is regenerated by `python3 corpus/build.py`.
!corpus/synthetic-transcripts.zip
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
report.json
report.html

# Written by `corpus/build.py --extract` for inspection; the ZIP is canonical.
corpus/src/

# Scratch space for the test suite — kept inside the project so a run never
# writes outside this folder. Safe to delete.
.tmp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store
